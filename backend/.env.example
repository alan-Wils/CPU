# Copy to .env and fill in. Used by the legacy Express API (cultivation, logs, etc.).

DATABASE_URL="file:./dev.db"
JWT_SECRET="change_me"

# Optional: OpenAI vision for Cultivation → Harvest “Extract with AI” on handwritten harvest sheets.
# Without this key, upload still works but extraction returns 503.
OPENAI_API_KEY=""
# Vision-capable model (default gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
