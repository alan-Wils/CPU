# Backend (Express) — copy to `.env` and fill in secrets. Never commit `.env`.

# SQLite (Prisma local dev in apps/api); path is relative to apps/api unless absolute
# DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (staging/production on Neon via Railway)
# Runtime: pooler host (…-pooler.….neon.tech)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Migrations: direct host (no -pooler); optional if migrate script can derive from DATABASE_URL
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Set false on extra API replicas so only the release/preDeploy step migrates
# RUN_PRISMA_MIGRATIONS=false

JWT_SECRET=

# Invite links in emails default to localhost if unset
APP_URL=http://localhost:3000

# Next.js → `@cpu/api` (Railway). Required on Vercel: full `https://…` API origin only (not the Vercel web URL), no trailing slash.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# When true, the web UI skips PUT /api/store (company JSON snapshot). Saves go through entity APIs → PostgreSQL only.
# Recommended on production (e.g. nexbatch.com + Railway API).
# NEXT_PUBLIC_SERVER_DATABASE_ONLY=true

# Gmail: use an App Password, not your normal Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients (first non-empty wins):
# EMAIL_FROM, SMTP_FROM, or SMTP_USER
EMAIL_FROM=
# SMTP_FROM=

# Persistent uploads on Railway / cloud (S3-compatible: AWS S3, Cloudflare R2, MinIO).
# Without these, check photos and cash receipts are stored on ephemeral disk and disappear after redeploy.
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Cloudflare R2: set S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com and S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# PaaS hosts often block SMTP egress; use HTTPS (set either this block or SMTP above)
# RESEND_API_KEY=
# RESEND_FROM=noreply@your-verified-domain.com
# RESEND_FALLBACK_SMTP=false
# ↑ set false while fixing Resend so a failed API call does not wait on blocked SMTP.
# RESEND_SMTP_AFTER_RESEND_4XX=true
# ↑ only if you want Gmail SMTP fallback after Resend 4xx (default: skip 4xx, avoids long timeouts).

# OpenAI (optional) — `@cpu/api` extraction “Create new name (AI)” (`POST /api/extraction-assist/suggest-product-names`).
# OPENAI_API_KEY=

# LeafLink inventory integration (company config fallback defaults)
# LEAFLINK_ENABLED=false
# LEAFLINK_COMPANY_SLUG=
# LEAFLINK_COMPANY_ID=
# LEAFLINK_USERNAME=
# LEAFLINK_API_KEY=
# LEAFLINK_BASE_URL=https://app.leaflink.com/api
# Optional: LeafLink company-staff id for POST /v2/order-payments/ `recorded_by` (Admin → LeafLink per company overrides).
# LEAFLINK_RECORDED_BY_STAFF_ID=
# LeafLink orders incremental sync (cron warm-sync + UI “Refresh Recent” — not full history)
# LEAFLINK_ORDER_SYNC_LOOKBACK_DAYS=90
# LEAFLINK_ORDER_SYNC_MAX_PAGES=25
# LEAFLINK_ORDER_SYNC_MAX_ROWS=2500
# LEAFLINK_SYNC_DEBUG=true
# Manual admin full rebuild only (POST /api/admin/leaflink/orders/full-rebuild)
# LEAFLINK_ORDERS_FULL_SYNC_MAX_PAGES=5000

# Analytics API short cache (reduces repeated Neon reads from dashboard polling)
# ANALYTICS_OVERVIEW_CACHE_TTL_MS=90000
# ANALYTICS_LIVE_OPS_CACHE_TTL_MS=60000
# API_TRANSFER_METRICS=true
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
