# Backend (Express) — copy to `.env` and fill in secrets. Never commit `.env`.

# SQLite (Prisma); path is relative to repo root unless you use an absolute URL
# DATABASE_URL="file:./backend/prisma/dev.db"

JWT_SECRET=

# Invite links in emails default to localhost if unset
APP_URL=http://localhost:3000

# Next.js → `@cpu/api` (Railway). Required on Vercel: full `https://…` API origin only (not the Vercel web URL), no trailing slash.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# When true, the web UI skips PUT /api/store (company JSON snapshot). Saves go through entity APIs → PostgreSQL only.
# Recommended on production (e.g. nexbatch.com + Railway API).
# NEXT_PUBLIC_SERVER_DATABASE_ONLY=true

# Gmail: use an App Password, not your normal Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients (first non-empty wins):
# EMAIL_FROM, SMTP_FROM, or SMTP_USER
EMAIL_FROM=
# SMTP_FROM=

# Persistent uploads on Railway / cloud (S3-compatible: AWS S3, Cloudflare R2, MinIO).
# Without these, check photos and cash receipts are stored on ephemeral disk and disappear after redeploy.
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Cloudflare R2: set S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com and S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# PaaS hosts often block SMTP egress; use HTTPS (set either this block or SMTP above)
# RESEND_API_KEY=
# RESEND_FROM=noreply@your-verified-domain.com
# RESEND_FALLBACK_SMTP=false
# ↑ set false while fixing Resend so a failed API call does not wait on blocked SMTP.
# RESEND_SMTP_AFTER_RESEND_4XX=true
# ↑ only if you want Gmail SMTP fallback after Resend 4xx (default: skip 4xx, avoids long timeouts).

# OpenAI (optional) — `@cpu/api` extraction “Create new name (AI)” (`POST /api/extraction-assist/suggest-product-names`).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
