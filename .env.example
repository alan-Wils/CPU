# Backend (Express) — copy to `.env` and fill in secrets. Never commit `.env`.

# SQLite (Prisma); path is relative to repo root unless you use an absolute URL
# DATABASE_URL="file:./backend/prisma/dev.db"

JWT_SECRET=

# Invite links in emails default to localhost if unset
APP_URL=http://localhost:3000

# Gmail: use an App Password, not your normal Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients (first non-empty wins):
# EMAIL_FROM, SMTP_FROM, or SMTP_USER
EMAIL_FROM=
# SMTP_FROM=

# PaaS hosts often block SMTP egress; use HTTPS (set either this block or SMTP above)
# RESEND_API_KEY=
# RESEND_FROM=noreply@your-verified-domain.com
# RESEND_FALLBACK_SMTP=false
# ↑ set false while fixing Resend so a failed API call does not wait on blocked SMTP.
# RESEND_SMTP_AFTER_RESEND_4XX=true
# ↑ only if you want Gmail SMTP fallback after Resend 4xx (default: skip 4xx, avoids long timeouts).
