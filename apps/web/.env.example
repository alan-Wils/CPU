# Public env vars (NEXT_PUBLIC_ are exposed to the browser and baked in at Vercel build time).
# Local: defaults also work via lib/publicEnv.ts when NODE_ENV=development and vars are unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Cannabis CPU
# Optional: when set, `/orders` in @cpu/web redirects to the NexBatch web origin.
NEXT_PUBLIC_NEXBATCH_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_STORE_COMPAT_WRITE=false