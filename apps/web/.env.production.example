# Vercel Production — set these in the dashboard (or via `vercel env pull` for local preview builds).
# Build must see NEXT_PUBLIC_* so the client bundle points at the Railway API.

NEXT_PUBLIC_API_BASE_URL=https://YOUR-RAILWAY-API-URL/api
NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-API-URL
NEXT_PUBLIC_APP_NAME=Cannabis CPU
NEXT_PUBLIC_ENABLE_STORE_COMPAT_WRITE=false
