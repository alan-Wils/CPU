// Local dev: SQLite. Use `npm run prisma:push` (not `prisma migrate`) for this schema.
// Staging/prod: see `prisma/schema.postgresql.prisma` + `prisma/migrations` + `prisma:migrate:deploy`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OPERATIONS_MANAGER
  CULTIVATION_SPECIALIST
  EXTRACTION_SPECIALIST
  PACKAGING_SPECIALIST
  EDIBLES
  EDIBLES_MANAGER
  FINANCIAL_ANALYST
  SALES_SPECIALIST
  DATABASE_ARCHITECT
  FULL_STACK_DEVELOPER
  QA_TESTER
  VIEW_ONLY
  FACILITY_MAINTENANCE_SPECIALIST
}

/// Workflow / org role inside a company (NexBatch portal + company login).
enum NexBatchCompanyRole {
  grow_staff
  extraction_staff
  packaging_staff
  trimming_staff
  lead_staff
  management
  admin
  owner
}

/// Platform-level identity for NexBatch operators (portal login without company code).
enum NexBatchPlatformRole {
  grow_staff
  extraction_staff
  packaging_staff
  trimming_staff
  lead_staff
  management
  admin
  owner
  nexbatch_admin
}

enum WorkflowStage {
  CULTIVATION
  EXTRACTION
  PACKAGING
  EDIBLES
}

enum CultivationAutoStatus {
  OPEN
  AUTO_COMPLETED
}

enum SourceMaterialRole {
  A_GRADE_FLOWER
  POPCORN
  DRY_TRIM
  FRESH_FROZEN
}

enum ExtractionSourceType {
  DRY_TRIM
  FRESH_FROZEN
}

enum ExtractionProductCategory {
  CURED_WAX
  LIVE
}

enum ExtractionPhase {
  PENDING_BIOMASS_PREP
  BIOMASS_PREP_ACTIVE
  READY_FOR_PROCESSING
  IN_PROGRESS
  COMPLETED
}

enum PackagingRunStatus {
  IN_PROGRESS
  COMPLETED
}

enum CultivationPackagingLine {
  A_GRADE_FLOWER
  POPCORN
}

enum CashLogDirection {
  INCOMING
  OUTGOING
}

enum CashLogDepartment {
  CULTIVATION
  EXTRACTION
  PACKAGING
  GENERAL
}

enum MarketplaceProductAvailability {
  AVAILABLE
  INTERNAL
  NOT_AVAILABLE
}

enum MarketplaceProductSource {
  MANUAL
  LEAFLINK
}

enum MarketplaceOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  FULFILLED
  CANCELLED
}

/// Third-party / infra usage for NexBatch admin cost visibility (app-estimated from logged events).
enum UsageProvider {
  vercel
  railway
  neon
  resend
  cloudflare_r2
  ai
}

/// Colorado MED employee R&D sample / designated sampling employee records (company-scoped).
enum EmployeeSampleLicenseType {
  MEDICAL
  RETAIL
}

enum EmployeeSampleSourceType {
  CULTIVATION
  MANUFACTURING
  PACKAGING
  OTHER
}

enum EmployeeSampleProductCategory {
  FLOWER
  CONCENTRATE
  EDIBLE
  NON_EDIBLE_PRODUCT
}

enum EmployeeSampleUnit {
  GRAMS
  SERVINGS
  EACH
}

enum EmployeeSamplePurpose {
  QUALITY_CONTROL
  PRODUCT_DEVELOPMENT
}

model Company {
  id                String @id @default(cuid())
  name              String
  slug              String @unique
  nextChainSequence Int    @default(1)
  /// `invited` until the OWNER invite is accepted; then `active`.
  lifecycleStatus   String @default("invited")

  users        User[]
  memberships CompanyMembership[]
  configRows   CompanyConfig[]
  inviteTokens InviteToken[]

  cultivationBatches  CultivationBatch[]
  sourceChains        SourceChain[]
  extractionRuns      ExtractionRun[]
  packagingLots       PackagingLot[]
  cultivationPacks    CultivationPackagingRun[]
  laborEntries        LaborEntry[]
  cpuSnapshots        CpuSnapshot[]
  auditLogs           AuditLog[]
  taskLogs            TaskLog[]
  trimFlowStates      TrimFlowState[]
  freshFrozenAllocs   FreshFrozenAllocation[]
  extractionBiomass   ExtractionBiomassInput[]
  storeSnapshots      CompanyStore[]
  checkCaptures       CheckCapture[]
  cashLogEntries      CashLogEntry[]
  usageEvents                 UsageEvent[]
  nexbatchCompanyUsageLogs    NexbatchCompanyUsageLog[]

  leafLinkStoredOrders     LeafLinkStoredOrder[]
  integrationSyncStates  IntegrationSyncState[]

  serviceSettings CompanyServiceSettings?

  marketplaceProducts MarketplaceProduct[]
  marketplaceOrdersAsBuyer  MarketplaceOrder[] @relation("MarketplaceOrderBuyer")
  marketplaceOrdersAsSeller MarketplaceOrder[] @relation("MarketplaceOrderSeller")

  sectionCalendarEvents SectionCalendarEvent[]

  conversationParticipants ConversationParticipant[]
  conversationMessagesSent ConversationMessage[] @relation("ConversationMessageSenderCompany")

  facilityProfile                   FacilityProfile?
  facilityWorkOrders                FacilityWorkOrder[]
  facilityAlerts                    FacilityAlert[]
  facilitySystemStatuses            FacilitySystemStatus[]
  facilityEnvironmentalReadings     FacilityEnvironmentalReading[]
  facilityCalendarEvents            FacilityCalendarEvent[]
  facilityPreventiveMaintenanceTasks FacilityPreventiveMaintenanceTask[]
  facilityAssets                    FacilityAsset[]
  facilityPartRequests                FacilityPartRequest[]
  facilityLocations                 FacilityLocation[]

  edibleBatches           EdibleBatch[]
  edibleTaskLogs          EdibleTaskLog[]
  edibleOilReservations   EdibleOilReservation[]

  employeeSamples EmployeeSample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per company after baseline facilities seed (Green Valley mock profile + related rows).
model FacilityProfile {
  id               String  @id @default(cuid())
  companyId        String  @unique
  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityName     String
  addressLine1     String
  cityStateZip     String
  licenseNumber    String
  facilitySizeSqFt Int
  builtYear        Int
  roomCountsJson   Json
  mtdTotalCost     Float
  mtdCostSeriesJson Json
  /// Frozen mockup KPI/chart numbers (prompt); total WO card adds (dbCount - seededTableRows).
  kpiSnapshotJson  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FacilityWorkOrder {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId   String
  title        String
  location     String
  category     String
  priority     String
  status       String
  assignedTo   String
  dueDate      DateTime
  dueMeta      String?
  description  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, externalId])
  @@index([companyId, status])
}

model FacilityAlert {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  locationLabel String
  valueLabel    String?
  statusLabel   String?
  timeLabel     String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([companyId, sortOrder])
}

model FacilitySystemStatus {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  status    String
  sortOrder Int      @default(0)

  @@index([companyId, sortOrder])
}

model FacilityEnvironmentalReading {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metricKey          String
  label              String
  valueDisplay       String
  idealRangeDisplay  String
  sparklineJson      Json
  statusLabel        String
  sortOrder          Int      @default(0)

  @@index([companyId, sortOrder])
}

model FacilityCalendarEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  yearMonth String
  day       Int
  kind      String
  createdAt DateTime @default(now())

  @@index([companyId, yearMonth])
}

model FacilityPreventiveMaintenanceTask {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskName     String
  assetSystem  String
  frequency    String
  assignedTo   String
  nextDueDate  DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
}

model FacilityAsset {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetName    String
  category     String
  location     String
  serialNumber String
  installDate  DateTime
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model FacilityPartRequest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partName   String
  quantity   Int
  neededFor  String
  priority   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model FacilityLocation {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationName String
  locationType String
  parentArea   String
  sqFt         Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

/// Per-company feature flags (NexBatch portal + Sales Platform).
model CompanyServiceSettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productionEnabled              Boolean @default(true)
  salesSellerEnabled             Boolean @default(false)
  salesBuyerEnabled              Boolean @default(false)
  leafLinkInventorySyncEnabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketplaceProduct {
  id                   String                         @id @default(cuid())
  companyId            String
  company              Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  category             String?
  productType          String?
  strainName           String?
  flavorName           String?
  sku                  String?
  unitSize             String?
  price                Float
  quantityAvailable    Float
  imageUrl             String?
  imageKey             String?
  /// AUTO | CONTAIN | COVER — card image scaling (client default AUTO).
  imageDisplayMode     String?
  availabilityStatus   MarketplaceProductAvailability
  source               MarketplaceProductSource
  leafLinkInventoryId  String?
  leafLinkRawJson      Json?
  potencyLabel         String?
  strainDominance      String?

  orderItems  MarketplaceOrderItem[]
  extraImages MarketplaceProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([availabilityStatus])
  @@index([source])
  @@index([leafLinkInventoryId])
}

model MarketplaceProductImage {
  id        String             @id @default(cuid())
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  imageKey  String?
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([productId])
  @@unique([productId, position])
}

model MarketplaceOrder {
  id               String                 @id @default(cuid())
  buyerCompanyId   String
  buyerCompany     Company                @relation("MarketplaceOrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sellerCompanyId  String
  sellerCompany    Company                @relation("MarketplaceOrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  status           MarketplaceOrderStatus @default(PENDING)
  subtotal         Float
  total            Float
  notes            String?
  createdByUserId  String?
  createdByUser    User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  items MarketplaceOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceOrderItem {
  id                String              @id @default(cuid())
  orderId           String
  order             MarketplaceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           MarketplaceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  skuSnapshot       String?
  unitSizeSnapshot  String?
  priceSnapshot     Float
  quantity          Float
  lineTotal         Float
  imageUrlSnapshot  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model UsageEvent {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider      UsageProvider
  feature       String
  unitType      String
  units         Float
  estimatedCost Float         @default(0)
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, provider, createdAt])
}

/// NexBatch-initiated usage attributed per company (e.g. platform staff emails split across attached tenants).
model NexbatchCompanyUsageLog {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId   String?
  feature       String
  category      String   @default("nexbatch_platform")
  provider      String
  unitType      String
  units         Float    @default(0)
  estimatedCost Float    @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, provider, createdAt])
}

/// Monthly vendor totals synced with backend-only API tokens.
/// Provider totals are project-level and may be allocated to companies using UsageEvent share.
model VendorBillingSnapshot {
  id           String        @id @default(cuid())
  provider     UsageProvider
  /// UTC month key: YYYY-MM.
  month        String
  /// Vendor MTD / period USD when known (manual entry or future vendor dollar APIs). Null = no authoritative vendor total.
  totalCost    Float?
  currency     String        @default("USD")
  rawUsageJson Json?
  /// live_synced | missing_token | sync_failed | estimated_only | no_activity
  status       String
  syncedAt     DateTime?
  /// Inclusive billing window (optional; defaults derived from `month` when unset).
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  /// vendor_api | manual | estimated
  source       String        @default("estimated")
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([provider, month])
  @@index([month, provider])
}

model User {
  id           String  @id @default(cuid())
  /// Optional “home” company row; access to tenant data is driven by `CompanyMembership`.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email        String  @unique
  passwordHash String
  /// Legacy Prisma role; kept for invites, audits, and gradual UI mapping.
  role         UserRole
  isActive     Boolean @default(true)
  /// Set only for NexBatch portal operators (login without company code).
  platformRole NexBatchPlatformRole?

  memberships         CompanyMembership[]
  laborEntries        LaborEntry[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  checkCaptures       CheckCapture[]       @relation("CheckCaptureCreatedBy")
  cashLogEntries      CashLogEntry[]       @relation("CashLogCreatedBy")
  marketplaceOrdersCreated MarketplaceOrder[]
  conversationMessagesSent ConversationMessage[]

  edibleBatchesCreated         EdibleBatch[]            @relation("EdibleBatchCreatedBy")
  edibleTaskLogsCreated        EdibleTaskLog[]          @relation("EdibleTaskLogCreatedBy")
  edibleOilReservationsCreated EdibleOilReservation[]   @relation("EdibleOilReservationCreatedBy")

  employeeSamplesReceived EmployeeSample[] @relation("EmployeeSampleEmployee")
  employeeSamplesCreated  EmployeeSample[] @relation("EmployeeSampleCreatedBy")

  @@index([companyId])
}

model EmployeeSample {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("EmployeeSampleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  employeeNameSnapshot           String
  employeeIdentifierSnapshot     String?
  licenseType                    EmployeeSampleLicenseType
  sourceType                     EmployeeSampleSourceType
  productCategory                EmployeeSampleProductCategory
  productName                    String
  batchNumber                    String
  metrcPackageTag                String
  quantity                       Float
  unit                           EmployeeSampleUnit
  thcMgPerServing                Float?
  transferDate                   DateTime
  calendarMonth                  String
  purpose                        EmployeeSamplePurpose
  sopAcknowledged                Boolean
  employeeConfirmedMonthlyLimit  Boolean
  notCompensationAcknowledged    Boolean
  noOnPremConsumptionAcknowledged Boolean
  noResaleOrTransferAcknowledged Boolean
  createdByUserId                String
  createdBy                      User   @relation("EmployeeSampleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  notes                          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, calendarMonth])
  @@index([companyId, employeeId, calendarMonth])
  @@index([companyId, transferDate])
  @@index([companyId, batchNumber])
  @@index([companyId, metrcPackageTag])
}

model CompanyMembership {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      NexBatchCompanyRole
  /// JSON string[] of `AppPermissionId` (e.g. `page.cultivation`). `null` = use role defaults.
  appPermissions Json?
  /// Staff rewards program opt-in for this company (Admin Edit user).
  rewardsEnrolled Boolean @default(false)
  /// Optional per-user schedule for cash / financial log digest email (see `cashLogEodPrefsSchema`).
  cashLogEodPrefs      Json?
  /// Last successful EOD digest send (dedupe + ops); optional.
  cashLogEodLastSentAt DateTime?
  /// Bumped whenever digest schedule JSON is saved (UI/admin). Used with `cashLogEodDigestSentScheduleGeneration`.
  cashLogEodScheduleGeneration Int @default(0)
  /// Generation value that last successful digest matched; duplicates same calendar day suppressed only when equals `cashLogEodScheduleGeneration`.
  cashLogEodDigestSentScheduleGeneration Int?
  /// Per-user per-company peer task/order notification inbox (syncs across devices).
  peerNotificationInbox PeerNotificationInbox?
  /// Receive cultivation climate (temp/RH) threshold alerts for this company workspace.
  cultivationAlertsEnabled Boolean @default(false)
  /// Colorado MED: Designated R-and-D Sampling Employee (Metrc role effective 2026-01-05).
  designatedRnDSamplingEmployee Boolean @default(false)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model PeerNotificationInbox {
  id           String              @id @default(cuid())
  membershipId String              @unique
  membership   CompanyMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  items        Json                @default("[]")
  updatedAt    DateTime            @updatedAt

  @@index([membershipId])
}

model SourceChain {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cultivationBatchId String           @unique
  cultivationBatch   CultivationBatch @relation(fields: [cultivationBatchId], references: [id], onDelete: Cascade)
  chainKey           String
  sourcePackages     SourcePackage[]

  createdAt DateTime @default(now())

  @@unique([companyId, chainKey])
  @@index([companyId])
}

model SourcePackage {
  id            String             @id @default(cuid())
  sourceChainId String
  sourceChain   SourceChain        @relation(fields: [sourceChainId], references: [id], onDelete: Cascade)
  role          SourceMaterialRole
  canonicalName String

  createdAt DateTime @default(now())

  @@unique([sourceChainId, role])
  @@index([sourceChainId])
}

model TrimFlowState {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cultivationBatchId String   @unique
  batch              CultivationBatch @relation(fields: [cultivationBatchId], references: [id], onDelete: Cascade)
  toExtractionGrams  Float    @default(0)
  consumedGrams      Float    @default(0)

  updatedAt DateTime @updatedAt
}

model FreshFrozenAllocation {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cultivationBatchId String   @unique
  batch              CultivationBatch @relation(fields: [cultivationBatchId], references: [id], onDelete: Cascade)
  toExtractionGrams  Float   @default(0)
  lastExtractionRunId String?

  updatedAt DateTime @updatedAt
}

model CultivationBatch {
  id    String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  strain     String
  strainAcronym String
  batchChainCode String
  plantedAt  DateTime

  /// Legacy: equals total harvest; maintained on create for Data Hub
  expectedYieldGrams Float

  aGradeFlowerGrams Float
  popcornGrams     Float
  trimGrams        Float
  freshFrozenGrams Float

  autoStatus      CultivationAutoStatus @default(OPEN)
  autoCompletedAt DateTime?

  room  String?
  bay   String?
  table String?

  sourceChain        SourceChain?
  extractionBiomass  ExtractionBiomassInput[] @relation("BiomassFromCultivation")
  extractionRuns     ExtractionRun[] @relation("CultivationExtraction")
  cultPackagingRuns  CultivationPackagingRun[]

  trimState      TrimFlowState?
  freshFrozen    FreshFrozenAllocation?

  /// Client-side operational UI (stages, tasks, METRC fields, etc.); relational fields remain columns above.
  cultivationUiState Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, updatedAt])
  @@index([autoStatus])
}

model CultivationPackagingRun {
  id    String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cultivationBatchId String
  batch              CultivationBatch @relation(fields: [cultivationBatchId], references: [id], onDelete: Restrict)

  line   CultivationPackagingLine
  status PackagingRunStatus @default(IN_PROGRESS)

  terpeneGramsCumulative       Float   @default(0)
  netMaterialGramsInProgress  Float   @default(0)
  netMaterialGramsCompleted   Float   @default(0)

  sessions PackagingWeighSession[]

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([companyId, cultivationBatchId, line, status])
}

model PackagingWeighSession {
  id     String  @id @default(cuid())
  packagingRunId String
  run            CultivationPackagingRun @relation(fields: [packagingRunId], references: [id], onDelete: Cascade)
  netProductGrams Float
  terpeneGrams    Float @default(0)
  note   String?
  createdAt DateTime @default(now())

  @@index([packagingRunId, createdAt])
}

model ExtractionRun {
  id    String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cultivationBatchId String
  cultivationBatch   CultivationBatch @relation("CultivationExtraction", fields: [cultivationBatchId], references: [id], onDelete: Restrict)

  phase ExtractionPhase @default(PENDING_BIOMASS_PREP)

  productCategory ExtractionProductCategory?

  biomassPrepStartedAt   DateTime?
  socksStartAt            DateTime?
  socksEndAt                DateTime?
  biomassPrepDurationSeconds Int?

  method      String @default("")
  inputGrams  Float  @default(0)
  outputGrams Float  @default(0)
  supplyUsed  String?

  biomassLines ExtractionBiomassInput[] @relation("RunBiomass")
  packagingLots       PackagingLot[]
  edibleBatches       EdibleBatch[]
  edibleOilReservations EdibleOilReservation[]

  /// Rich extraction UI state (tasks, labels, workflow); merged with columns on read.
  extractionUiState Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([companyId, phase])
  @@index([companyId, createdAt])
  @@index([companyId, finishedAt])
  @@index([cultivationBatchId])
}

model ExtractionBiomassInput {
  id    String  @id @default(cuid())
  extractionRunId String
  run               ExtractionRun @relation("RunBiomass", fields: [extractionRunId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cultivationBatchId String
  cultivationBatch  CultivationBatch @relation("BiomassFromCultivation", fields: [cultivationBatchId], references: [id], onDelete: Restrict)
  sourceType  ExtractionSourceType
  grams       Float
  sockWeightGrams Float?

  createdAt DateTime @default(now())

  @@index([extractionRunId, cultivationBatchId])
  @@index([companyId])
}

model PackagingLot {
  id    String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)

  status PackagingRunStatus @default(IN_PROGRESS)
  /// Net material only (terpenes excluded from weight caps)
  netOutputGrams Float      @default(0)
  terpeneGrams   Float      @default(0)

  sku            String
  units          Int   @default(0)
  gramsPerUnit   Float
  defaultTemplate String?

  /// Packaging UI-only fields merged with relational columns on read.
  packagingUiState Json?

  /// When this lot was created from an edible kitchen transfer (traceability).
  edibleBatchId String? @unique
  edibleBatch   EdibleBatch? @relation(fields: [edibleBatchId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, finishedAt])
  @@index([extractionRunId])
  @@index([status])
}

/// Cannabis infused product kitchen batch (gummies, chocolates, etc.).
model EdibleBatch {
  id          String  @id @default(cuid())
  companyId String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  batchNumber String
  sku         String
  flavor      String
  productType String
  status      String  @default("PENDING")
  stage       String  @default("OIL_INTAKE")

  targetMgPerPiece Float
  targetPieces     Int
  expectedYield    Int?
  actualYield      Int?

  oilInputGrams     Float  @default(0)
  totalMgInput      Float  @default(0)
  wasteGrams        Float  @default(0)
  potencyMgPerGram  Float?

  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)

  notes String?

  packagingLot PackagingLot?

  createdById String
  createdBy   User     @relation("EdibleBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  startDate     DateTime?
  completedDate DateTime?

  taskLogs     EdibleTaskLog[]
  ingredients  EdibleIngredient[]
  qaTests      EdibleQaTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, batchNumber])
  @@index([companyId, stage])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([extractionRunId])
}

/// Kitchen hold on Live Resin oil before an edible batch is created (reduces shared pool availability).
model EdibleOilReservation {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)

  reservedGrams Float
  label         String?
  notes         String?
  /// ACTIVE = holding oil; RELEASED = manually cancelled; CONSUMED = fully applied to edible batches.
  status        String @default("ACTIVE")

  createdById String
  createdBy   User   @relation("EdibleOilReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  releasedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, extractionRunId])
  @@index([companyId, status])
  @@index([extractionRunId, status])
}

model EdibleTaskLog {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  edibleBatchId   String
  edibleBatch     EdibleBatch @relation(fields: [edibleBatchId], references: [id], onDelete: Cascade)

  taskType        String
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  employees       String?
  notes           String?
  temperature     Float?
  weight          Float?

  createdById String
  createdBy   User   @relation("EdibleTaskLogCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, completedAt])
  @@index([edibleBatchId, createdAt])
  @@index([edibleBatchId, completedAt])
}

model EdibleIngredient {
  id            String      @id @default(cuid())
  edibleBatchId String
  edibleBatch   EdibleBatch @relation(fields: [edibleBatchId], references: [id], onDelete: Cascade)

  ingredientName String
  lotNumber      String?
  weight         Float
  unit           String    @default("g")

  createdAt DateTime @default(now())

  @@index([edibleBatchId])
}

model EdibleQaTest {
  id              String      @id @default(cuid())
  edibleBatchId   String
  edibleBatch     EdibleBatch @relation(fields: [edibleBatchId], references: [id], onDelete: Cascade)

  potencyStatus     String @default("PENDING")
  homogeneityStatus String @default("PENDING")
  microbialStatus   String @default("PENDING")
  failedReason      String?
  submittedAt       DateTime?
  passedAt          DateTime?
  notes             String?
  reviewedById      String?

  createdAt DateTime @default(now())

  @@index([edibleBatchId, createdAt])
}

model LaborEntry {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  stage       WorkflowStage
  taskType    String @default("OPERATIONAL")
  hours       Float
  hourlyRate  Float
  totalCost   Float
  referenceId String?
  cultivationBatchId String?

  createdAt  DateTime      @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, stage, createdAt])
  @@index([userId])
  @@index([cultivationBatchId])
}

model CpuSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       String
  totalLabor   Float
  totalOutputG Float
  cpuPerGram   Float
  createdAt    DateTime @default(now())

  @@index([companyId, period])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

model TaskLog {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String
  stage       WorkflowStage
  note        String
  minutes     Int
  referenceId String?
  createdAt   DateTime      @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, stage, createdAt])
}

/// Per-section scheduled tasks (company timezone `dateYmd`); not workflow TaskLog completions.
model SectionCalendarEvent {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// cultivation | extraction | packaging
  section           String
  /// YYYY-MM-DD in company display timezone
  dateYmd           String
  title             String
  notes             String?
  batchRef          String?
  /// Stable key for cultivation template sync upserts (e.g. cult:tpl:{id}:batch:{batchId}).
  templateDedupeKey String?
  /// When true, sync may update date/title/notes; set false when an operator edits the row in the UI.
  templateManaged   Boolean  @default(false)
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, section, dateYmd])
  @@unique([companyId, section, templateDedupeKey])
}

/// Direct messaging between company workspaces (PostgreSQL migrations 20260514120000, 20260516120000).
model Conversation {
  id            String   @id @default(cuid())
  title         String?
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  participants  ConversationParticipant[]
  messages      ConversationMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  companyId      String
  lastReadAt     DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([conversationId, companyId])
  @@index([companyId])
}

model ConversationMessage {
  id               String    @id @default(cuid())
  conversationId   String
  senderCompanyId  String
  senderUserId     String
  body             String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  deletedByUserId  String?
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderCompany    Company        @relation("ConversationMessageSenderCompany", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  senderUser       User           @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderCompanyId])
  @@index([deletedAt])
}

model CompanyConfig {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key        String
  valueJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, key])
}

model CompanyStore {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key        String   @default("legacy_frontend_store")
  valueJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, key])
}

/// LeafLink orders-received rows persisted when Orders page or sync pulls from LeafLink (analytics reads from here).
model LeafLinkStoredOrder {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leafLinkKey     String
  buyerCustomerId String    @default("")
  customerName    String    @default("")
  statusRaw       String    @default("")
  createdOn       DateTime?
  totalUsd        Float?
  payload         Json
  sourcePage      Int?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([companyId, leafLinkKey])
  @@index([companyId, createdOn])
}

/// Per-company integration sync cursor, lock, and last-run stats (e.g. LeafLink orders incremental sync).
model IntegrationSyncState {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider         String
  resource         String
  lastSuccessAt    DateTime?
  cursorJson       String?
  lockStartedAt    DateTime?
  lockOwner        String?
  lastMode         String?
  lastPagesPulled  Int?
  lastRowsPersisted Int?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, provider, resource])
  @@index([companyId, provider])
}

model CheckCapture {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation("CheckCaptureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  checkDate       DateTime?
  amount          Float?
  checkNumber     String?
  payerName       String?
  routingNumber   String?
  accountNumber   String?
  bankName        String?
  memo            String?
  invoiceNumber   String?
  imageUrl        String
  stubImageUrl    String?
  rawOcrJson      String?
  leaflinkOrderId String?
  leaflinkOrderNumber String?
  leaflinkPaymentId String?
  leaflinkPaymentStatus String?
  leaflinkMatchedAt DateTime?
  leaflinkPaidAt DateTime?
  leaflinkPaymentResponseJson String?
  /// not_matched | matched | payment_posted | failed
  paymentSyncStatus String @default("not_matched")
  paymentSyncError String?
  /// Successful LeafLink posts for multi-invoice checks (`[{ orderNumber, paymentId, amount, postedAt }]`).
  leaflinkPostedPayments Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([companyId, paymentSyncStatus, createdAt])
}

model CashLogEntry {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User               @relation("CashLogCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  direction       CashLogDirection
  amount          Float
  /** Incoming: counterparty / payor company name. */
  payeeCompany    String?
  invoiceNumber   String?
  /** Outgoing: which internal department received the spend. */
  department      CashLogDepartment?
  memo            String?
  entryDate       DateTime?
  /// Outgoing only: optional receipt image (`/uploads/cash-receipts/...`).
  receiptImageUrl String?
  /// Successful LeafLink posts when incoming cash is applied to orders (`[{ orderNumber, paymentId, amount, postedAt }]`).
  leaflinkPostedPayments Json?
  /// Mirrors check capture: not_matched | matched | payment_posted | failed
  leaflinkPaymentSyncStatus String @default("not_matched")
  leaflinkPaymentSyncError String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId, createdAt])
  @@index([createdByUserId, createdAt])
}

model InviteToken {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole
  tokenHash  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([companyId, email])
}

model PlatformStaffInvite {
  id             String    @id @default(cuid())
  email          String
  platformRole   String
  companyIds     Json
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([createdBy])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}
