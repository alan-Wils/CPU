# === Railway + Neon (staging) — set in Railway “Variables” only; do not commit real secrets. ===
#
# Storing DATABASE_URL: paste your Neon string from the Neon dashboard. Remove query params
# you do not need, but keep ?sslmode=require. Never commit real passwords to git.
#
# If a password or URL with credentials was ever pasted into chat, Slack, or a ticket, rotate
# the Neon role password and update DATABASE_URL in Railway.

NODE_ENV=production
# Railway may inject PORT; if unset, the API defaults to 4000. Prefer Railway’s $PORT in production.
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="replace-with-long-secure-random-secret-use-openssl-rand-base64-48"
JWT_EXPIRES_IN=15m

# Single Vercel origin, or comma-separated: https://a.vercel.app,https://b.vercel.app
# Must NOT be * when NODE_ENV=production.
CORS_ORIGIN=https://your-vercel-url.vercel.app
APP_URL=https://your-vercel-url.vercel.app
OWNER_BOOTSTRAP_EMAIL=owner@budfox.com

# Outbound email (optional). If you set one SMTP_ field, the API expects host, port, and SMTP_FROM.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# SMTP_FROM="Cannabis CPU <onboarding@yourdomain.com>"
