# === Production (Railway or other host) — store only in the host secret store, never in git. ===

NODE_ENV=production
# Match your platform’s $PORT; default in code is 4000.
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@ep-prod-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Distinct, long, rotated from staging; 32+ characters required when NODE_ENV=production.
JWT_SECRET=replace-with-long-secure-different-from-staging
JWT_EXPIRES_IN=15m

# Comma-separated HTTPS origins for your app only (no *).
CORS_ORIGIN=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com
OWNER_BOOTSTRAP_EMAIL=owner@budfox.com

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
