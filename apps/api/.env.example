# Copy to `.env` for local development (SQLite + API on your machine).
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace_me_with_a_secure_32_plus_character_secret"
JWT_EXPIRES_IN="15m"
PORT=4000
# `*` in dev. Staging/prod: set to your Vercel origin, e.g. `https://cpu-web-staging.vercel.app` or `https://app.staging.yourdomain.com` (comma-separated for multiple)
CORS_ORIGIN="*"
# Used for invite/reset link bases when you add outbound email; match your deployed web app URL
# APP_URL="http://localhost:3000"
# Optional: first company creation path for owner bootstrap; see server/bootstrap logic if enabled
# OWNER_BOOTSTRAP_EMAIL="owner@example.com"

# --- Outbound email (optional until wired in code) ---
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxx"
# SMTP_FROM="Cannabis CPU <onboarding@yourdomain.com>"
