{
  "name": "@cpu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.postgresql.prisma && tsc -p tsconfig.json",
    "start": "npx prisma migrate deploy --schema=prisma/schema.postgresql.prisma && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:sync-pg": "node scripts/sync-prisma-postgres-schema.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:pg": "prisma migrate dev --schema=prisma/schema.postgresql.prisma",
    "prisma:migrate:deploy": "node scripts/prisma-migrate-pg-deploy.mjs",
    "prisma:validate:pg": "prisma validate --schema=prisma/schema.postgresql.prisma",
    "prisma:validate:sqlite": "prisma validate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate && prisma validate --schema=prisma/schema.postgresql.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:nexbatch": "tsx prisma/seed-nexbatch-operators.ts",
    "prisma:push": "prisma db push",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cpu/shared": "file:../../packages/shared",
    "@aws-sdk/client-s3": "^3.738.0",
    "@prisma/client": "6.16.2",
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "nodemailer": "^8.0.7",
    "prisma": "6.16.2",
    "typescript": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "vitest": "^2.1.9"
  }
}
